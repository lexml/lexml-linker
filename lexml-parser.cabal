cabal-version:      3.8
name:               lexml-parser
version:            1.4.11
synopsis:           Parser for references between Brazilian legal norms
description:
  Identifies references to Brazilian legal norms and renders them as LexML
  URNs, annotated XML, or linked HTML.
category:           Text
license:            LGPL-2.1-only
license-file:       LICENSE
author:             Joao Nicola
maintainer:         jrafael@senado.gov.br
build-type:         Simple

source-repository head
  type:     git
  location: https://github.com/lexml/lexml-linker.git

library
  exposed-modules:
      LexML.Linker
      LexML.URN.Parser
  other-modules:
      LexML.Linker.Decorator
      LexML.Linker.Estados
      LexML.Linker.HtmlCleaner
      LexML.Linker.Lexer
      LexML.Linker.LexerPrim
      LexML.Linker.Municipios
      LexML.Linker.Parser
      LexML.Linker.ParserBase
      LexML.Linker.Regras2
      LexML.Linker.RegrasSTF
      LexML.Linker.URLTransform
      LexML.Render
      LexML.URN.Atalhos
      LexML.URN.Show
      LexML.URN.Types
      LexML.URN.Utils
  autogen-modules:
      LexML.Linker.Lexer
  hs-source-dirs:
      src/main/haskell
  build-tool-depends:
      alex:alex
  build-depends:
      array        >=0.5  && <0.6
    , base         >=4.16 && <4.23
    , containers   >=0.6  && <0.9
    , mtl          >=2.2  && <2.4
    , network-uri  >=2.6  && <2.7
    , parsec       >=3.1  && <3.2
    , syb          >=0.7  && <0.8
    , tagsoup      >=0.14 && <0.15
    , utf8-string  >=1.0  && <1.1
  default-language: Haskell2010

executable lexml-linker-wasm
  main-is:          LinkerWasm.hs
  hs-source-dirs:   src/wasm/haskell
  default-language: Haskell2010

  if os(wasi)
    buildable: True
    build-depends:
        aeson             >=2.2 && <2.3
      , base              >=4.22 && <4.23
      , ghc-experimental  ==9.1401.*
      , lexml-parser
      , mtl               >=2.3 && <2.4
      , utf8-string       >=1.0 && <1.1
    ghc-options:
        -no-hs-main
        -optl-mexec-model=reactor
        -optl-Wl,--export=lexml_link
  else
    buildable: False
